# =============================================================================
# SEA - Sistema de Empadronamiento Animal
# Plantilla de variables de entorno. Copiar a .env y poner valores reales.
#   cp .env.example .env
# El archivo .env NUNCA se sube a git (ver .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# Base de datos (PostgreSQL 16)
# ---------------------------------------------------------------------------
POSTGRES_DB=sea
# Superusuario: solo lo usa el contenedor de la base para inicializarse.
# La aplicacion NUNCA se conecta con el.
POSTGRES_USER=sea_super
POSTGRES_PASSWORD=cambiame_password_superusuario
# Duena del esquema: la usa Flyway para crear y alterar tablas. Sin superusuario.
DB_OWNER_USER=sea_owner
DB_OWNER_PASSWORD=cambiame_password_duena
# Cuenta de la aplicacion: solo lee y escribe datos. Sin superusuario.
DB_APP_USER=sea_app
DB_APP_PASSWORD=cambiame_password_aplicacion
# Las tres cuentas se crean en el primer arranque de un volumen vacio
# (deploy/db/init/01-roles.sh). Generar cada contrasena con:  openssl rand -base64 24
# Puerto publicado en el HOST (solo docker-compose.local.yml). 5433 por
# convencion del equipo: evita chocar con un PostgreSQL local en 5432.
POSTGRES_PORT_HOST=5433

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT_HOST=8080

# Secreto HMAC para firmar los JWT.
# Minimo 64 caracteres. Generar con:  openssl rand -base64 64
# El arranque FALLA si es corto, de baja entropia o si es este valor de ejemplo.
APP_JWT_SECRET=CAMBIAME_generar_con_openssl_rand_base64_64_minimo_64_caracteres

# Vigencia de tokens (milisegundos)
# 1 hora - viaja en el header Authorization
APP_JWT_ACCESS_EXPIRATION=3600000
# 7 dias - solo en cookie HttpOnly
APP_JWT_REFRESH_EXPIRATION=604800000

# Origenes permitidos por CORS, separados por coma. Restrictivo: sin comodines.
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# ---------------------------------------------------------------------------
# Usuario inicial (semilla)
# NO existe usuario con password por defecto conocida. Se crea con este valor
# y con b_cambio_password_requerido = true: obliga a cambiarla al primer login.
# ---------------------------------------------------------------------------
APP_ADMIN_USUARIO=superadmin
APP_ADMIN_PASSWORD=CAMBIAME_password_inicial_fuerte
APP_ADMIN_CORREO=informatica@ejemplo.gob.mx

# ---------------------------------------------------------------------------
# Almacenamiento de documentos personales
# Ruta DENTRO del contenedor, montada como volumen. Queda FUERA del document
# root: los archivos jamas se sirven por URL directa, solo por endpoint
# autenticado que valida rol y deja registro en bitacora.
# ---------------------------------------------------------------------------
APP_STORAGE_PATH=/var/sea/storage
APP_STORAGE_MAX_FILE_MB=10

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Ruta relativa: el Nginx del contenedor reenvia /api al backend, igual que
# hara el proxy inverso en el servidor. Asi el navegador ve un solo origen.
VITE_API_URL=/api
FRONTEND_PORT_HOST=80

# ---------------------------------------------------------------------------
# Correo (stub en este sprint: no envia, solo registra en bitacora)
# ---------------------------------------------------------------------------
APP_MAIL_ENABLED=false
APP_MAIL_HOST=smtp.ejemplo.gob.mx
APP_MAIL_PORT=587
APP_MAIL_USERNAME=notificaciones@ejemplo.gob.mx
APP_MAIL_PASSWORD=cambiame_password_correo
APP_MAIL_FROM=notificaciones@ejemplo.gob.mx

# ---------------------------------------------------------------------------
# Red del reverse proxy (solo docker-compose.prod.yml)
# ---------------------------------------------------------------------------
PROXY_NETWORK=npm_default
# Subredes (CIDR) de los proxies cuya cabecera X-Forwarded-For se cree. Solo prod:
# la red interna del proyecto y la de Nginx Proxy Manager. Obtener la de NPM con
#   docker network inspect npm_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
APP_PROXIES_CONFIABLES=127.0.0.1/32,172.31.250.128/25,172.18.0.0/16

# ---------------------------------------------------------------------------
# Respaldos cifrados (deploy/respaldo.sh)
# ---------------------------------------------------------------------------
# Carpeta del servidor donde se guardan; fuera del proyecto y del document root.
RESPALDO_DIR=/var/backups/sea
# Dias que se conservan.
RESPALDO_DIAS=30
# Frase de cifrado (AES-256). Generar con:  openssl rand -base64 32
# Guardar una copia FUERA del servidor: sin ella los respaldos no se pueden abrir.
RESPALDO_CLAVE=cambiame_frase_de_cifrado_de_respaldos
